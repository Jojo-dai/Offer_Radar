{
  "_comment": "复制为 config.json 后按需修改。前端不读这个文件（前端靠 SDK 自动识别所属应用），它只是给你自己做任务 prompt 替换时的对照表。firstRun 三问由「首次运行引导」填写（见 README / docs/assets/first-run.svg）。",
  "_firstRun_comment": "identityMode: workbuddy=OAuth 账号通道 | selfhosted=自建 PG/Supabase（须先执行 scripts/auth-isolation.sql 并通过越权自检）。resumeStorage: db=脱敏文本≤20000字落 profiles.resume_text | profile_only=不落原文，写入一律不含 resume_text 字段。networkGate.result 由 bash scripts/check-network.sh 的实际结果填写，禁止凭用户自述通过。networkGate 判据自 2026-11-06 起改为「接口实测」：只要 jobs-guest 返回 ≥1 条岗位卡片即放行，出口 IP 仅作提示，不再参与门禁（旧版看 loc≠CN，代理抖动时会整天误跳过领英）。",

  "firstRun": {
    "identityMode": "workbuddy | selfhosted",
    "resumeStorage": "db | profile_only",
    "networkGate": {
      "checked": false,
      "probeEndpoint": "linkedin jobs-guest (see collect.linkedin.searchUrl)",
      "assertCardsGt": 0,
      "assertNoRedirectToCN": true,
      "lastHttpStatus": null,
      "lastCardCount": null,
      "result": "pending | dual_source | liepin_only",
      "userInformedSingleSource": false
    }
  },

  "applicationId": "wbapp_XXXXXXXXXXXX",
  "shareLink": "https://<your-app>.app.workbuddy.host/?sharecode=XXXXXXXX",

  "workspace": "C:/Users/<you>/WorkBuddy/<workspace>",
  "browseExe": "/c/Users/<you>/.workbuddy/skills/gstack/browse/dist/browse.exe",

  "collect": {
    "keywordsMode": "rotate",
    "keywordsCursor": ".workbuddy/tmp/kw-cursor.txt",
    "liepin": {
      "keywordsPerRun": 3,
      "pagesPerKeyword": 2,
      "searchUrl": "https://www.liepin.com/zhaopin/?key=<kw>&currentPage=<page>",
      "cardSelector": "a[data-nick=job-detail-job-info]",
      "perKeywordLimit": 45,
      "betweenKeywordsSeconds": [30, 60],
      "requiresProxy": false
    },
    "linkedin": {
      "_comment": "2026-11-06 重构：门禁判据从「出口 IP 非 CN」改为「接口返回卡片数>0」；采集改为脚本直连 jobs-guest，不再依赖 Edge 登录态。",
      "collector": "scripts/collect-linkedin-guest.py",
      "searchUrl": "https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=<kw>&location=<loc>&f_TPR=r604800&start=<offset>",
      "defaultLocation": "Shanghai, China",
      "keywordsPerRun": 4,
      "pagesPerKeyword": 5,
      "pageSize": 10,
      "perKeywordLimit": 50,
      "betweenPagesSeconds": 3,
      "betweenKeywordsSeconds": 4,
      "requiresBrowser": false,
      "requiresAuth": false,
      "genericKeywordGuard": {
        "_comment": "裸泛词（Project Manager / Consultant / Product Manager 等，且不带 SAP/BPC/AI/LLM/Digital 限定）自动补 SAP 前缀再搜",
        "enabled": true,
        "prefix": "SAP ",
        "words": ["Project Manager", "Consultant", "Senior Consultant", "Product Manager", "Solution Architect"]
      },
      "networkGate": {
        "_comment": "只看接口实测，不看出口 IP。IP 仅打印提示。",
        "probeKeywords": 2,
        "assertCardsGt": 0,
        "skipOn": ["302->linkedin.cn", "429", "451", "0 cards"],
        "neverFetchLinkedinCN": true,
        "exitCodeOnGateFail": 2
      }
    },
    "maxInsertPerRun": 200
  },

  "dedupe": {
    "key": "norm(company)|norm(position)",
    "statusScope": "ALL",
    "stripWords": ["招聘", "诚聘", "急招", "热招", "岗位名称", "职位名称", "岗位", "职位"],
    "urlFallback": "strip ?# then compare",
    "keepPriority": ["已投递", "面试中", "已查看", "待投递", "待确认", "不合适"]
  },

  "scoring": {
    "weights": {
      "skill": 0.35,
      "industry": 0.15,
      "level": 0.20,
      "salaryLocation": 0.15,
      "growth": 0.15
    },
    "temperature": 0.3,
    "batchSize": 20,
    "reasonMaxChars": 30,
    "hardConflictBelow": 50,
    "keywordBoost": {
      "_comment": "2026-11-05 修正「打分过严」：命中即加分，未命中不扣分。",
      "strongMatchKeywords": [
        "SAP BPC", "SAP Project Manager", "SAP Senior Consultant", "SAP Consultant",
        "BPC Consultant", "SAP S/4HANA", "全面预算", "合并报表", "业财一体化", "财务数字化"
      ],
      "skillFloorWhenHit": 70,
      "penaltyWhenMiss": 0
    }
  },

  "schedule": {
    "_comment": "2026-11-12 起改为阈值分派：本机定时器不可靠（休眠即丢触发、不回溯），不再依赖整点。",
    "mode": "threshold",
    "triggerIntervalHours": 2,
    "collectIfStaleHours": { "day": 8, "night": 14 },
    "dayRange": [7, 22],
    "pendingConsumeWindowMinutes": 30,
    "feedbackSync": ["10:00", "20:00"],
    "dashboardRefresh": ["08:40", "10:00", "18:40", "20:00"],
    "watchdog": "on-trigger",
    "stuckThresholdMinutes": 120,
    "duplicateRunGuardMinutes": 90
  }
}
